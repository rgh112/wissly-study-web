{
  "name": "wissly-study-api",
  "main": "server/app.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
